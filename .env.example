# GraphRec configuration. Copy to .env and replace every value marked CHANGE.
# Every setting is read by graphrec_core/settings.py and validated at startup.
# With GRAPHREC_ENV=production the API, worker and scheduler refuse to start on
# default, placeholder ("replace-with", "change-me", "local-only", "example")
# or short (< 32 characters) secrets. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Environment ───────────────────────────────────────────────────────────────
# development: local defaults, placeholder training and manual model registration.
# production:  strict secret checks; development-only features are refused.
GRAPHREC_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=graphrec
# Owner role: runs migrations only (CHANGE in production).
POSTGRES_OWNER_USER=graphrec_owner
POSTGRES_OWNER_PASSWORD=graphrec_owner_local_only
# Runtime role graphrec_app: NOBYPASSRLS, used by API, worker and scheduler (CHANGE).
POSTGRES_APP_PASSWORD=graphrec_app_local_only
# Compose builds DATABASE_URL from the values above. Set it directly only when
# running the API outside Compose:
# DATABASE_URL=postgresql+psycopg://graphrec_app:<password>@localhost:5432/graphrec
# Connection pool per process (uvicorn runs up to 40 request threads per process).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
# Upper bound for any single statement on the runtime connection.
DB_STATEMENT_TIMEOUT_MS=30000

# ── Network and processes ─────────────────────────────────────────────────────
# Host ports (development Compose binds API and Qdrant to 127.0.0.1 only).
API_PORT=8010
FRONTEND_PORT=5180
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Where the console sends API calls. Leave empty: nginx serves the console and
# proxies /v1 on the same origin (CSP allows only same-origin connections).
VITE_API_BASE_URL=
# Proxies whose X-Forwarded-For is trusted for the client address used by
# per-source limits. "*" is safe only while the API is reachable through nginx alone.
FORWARDED_ALLOW_IPS=*
# API worker processes per container. Rate limits and slot leases live in Redis.
WEB_CONCURRENCY=2

# ── Secrets (CHANGE all of these) ─────────────────────────────────────────────
AUDIT_HASH_SECRET=replace-with-a-long-random-local-secret
JWT_SIGNING_SECRET=replace-with-at-least-32-random-characters
API_KEY_HMAC_PEPPER=local-api-key-hmac-pepper-change-me
API_KEY_HASH_VERSION=1
# Shared operator token for /v1/platform routes. Leave empty to disable the
# operator console; when set it must be at least 32 characters.
PLATFORM_ADMIN_TOKEN=replace-with-at-least-32-random-characters-platform

# ── Sessions ──────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
# Absolute sign-in lifetime; refresh tokens rotate on every use and never extend it.
REFRESH_TOKEN_TTL_SECONDS=604800
# Lifetime of the one-time account setup token returned by tenant registration.
ACCOUNT_SETUP_TOKEN_TTL_SECONDS=86400

# ── Rate limits (shared across API processes through Redis) ───────────────────
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=60
SUBSCRIPTION_RATE_LIMIT=30
SUBSCRIPTION_RATE_WINDOW_SECONDS=60
USAGE_RATE_LIMIT=30
USAGE_RATE_WINDOW_SECONDS=60
API_KEY_RATE_LIMIT=10
API_KEY_RATE_WINDOW_SECONDS=60

# ── Request bounds ────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=16384
# Product and event batch endpoints (up to 1,000 items).
MAX_BULK_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=10485760
MAX_TENANT_NAME_LENGTH=200
MAX_IDEMPOTENCY_KEY_LENGTH=255
MAX_PASSWORD_LENGTH=1024
MAX_ACTIVE_API_KEYS_PER_TENANT=25
MAX_API_KEY_NAME_LENGTH=100
MAX_API_KEY_SCOPES=12
MAX_API_KEY_ROTATION_REASON_LENGTH=500
MAX_API_KEY_GRACE_SECONDS=86400

# ── Training and retraining ───────────────────────────────────────────────────
TRAINING_COOLDOWN_SECONDS=60
# XR-F-02/03: shortest allowed schedule and how often the scheduler evaluates policies.
RETRAINING_MIN_INTERVAL_MINUTES=60
SCHEDULER_TICK_SECONDS=15
# Host directory with pretrained DGSR artifacts (one sub-directory per artifact name),
# mounted read-only at MODEL_ARTIFACT_ROOT inside the containers.
MODEL_ARTIFACT_DIR=./model_artifacts
MODEL_ARTIFACT_ROOT=/artifacts
# Where trained tenant artifacts are written (a persistent volume in Compose).
GENERATED_MODEL_ROOT=/app/generated_artifacts

# ── Serving ───────────────────────────────────────────────────────────────────
# XR-F-09: cold-start popularity window, ending at the tenant's latest interaction.
FALLBACK_POPULARITY_WINDOW_DAYS=30
# XR-F-08 capacity controller (logical serving capacity; see docs/DECISIONS.md D-07).
CAPACITY_TARGET_RPM_PER_REPLICA=120
CAPACITY_SCALE_DOWN_STABILIZATION_SECONDS=120

# ── Redis (admission control and shared rate limits) ──────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_MS=30
SLOT_WAIT_MS=100
SLOT_LEASE_SECONDS=30

# ── Qdrant vector store ───────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6334
QDRANT_COLLECTION_PREFIX=graphrec
QDRANT_EMBEDDING_DIM=128
QDRANT_TOP_K=100
# Bound on every Qdrant call; serving falls back to in-process scoring on timeout.
QDRANT_TIMEOUT_SECONDS=5

# ── Local demo account (docker compose --profile demo) ────────────────────────
DEMO_TENANT_NAME=GraphRec Local Demo
DEMO_REGISTRATION_EMAIL=owner-demo@example.org
DEMO_LOGIN_EMAIL=demo-admin@example.org
DEMO_LOGIN_PASSWORD=local-demo-password-change-me
