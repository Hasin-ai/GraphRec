# GraphRec configuration.
#
# The full surface of BACKEND_PLAN.md §22.4. Every bound a user-facing message
# quotes is a named setting here, never a literal in code (BUILD_PROMPT §13.22):
# a limit that changed in code but not in the message produces a message that
# lies to the tenant.
#
# Copy to .env and change every secret before deploying anywhere. Settings
# refuses to start in production while a shipped default secret is still in
# place.

ENVIRONMENT=local

# ---------------------------------------------------------------- database
#
# Two roles, deliberately. Migrations run as the owner; the application connects
# as graphrec_app, a non-owner and non-superuser, so that FORCE ROW LEVEL
# SECURITY binds it. A superuser bypasses RLS regardless of FORCE.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphrec
POSTGRES_OWNER_USER=graphrec_owner
POSTGRES_OWNER_PASSWORD=graphrec_owner_local_only
POSTGRES_APP_USER=graphrec_app
POSTGRES_APP_PASSWORD=graphrec_app_local_only
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- redis
# Rate limits, locks, session context and the jti denylist. Nothing here is
# authoritative; all of it is reconstructible.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=graphrec_local
S3_SECRET_KEY=graphrec_local_secret
S3_BUCKET=graphrec
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# ---------------------------------------------------------------- service
API_PORT=8010
FRONTEND_PORT=5180
CORS_ALLOWED_ORIGINS=["http://localhost:5180"]

# ---------------------------------------------------------------- tokens
#
# EdDSA (Ed25519), not HS256 — D5. A per-tenant inference process must verify a
# token locally without calling the control plane, and a shared secret would let
# every one of those processes mint tokens. Public keys are published at
# GET /v1/.well-known/jwks.json.
#
#   Generate with: python scripts/gen_jwt_keys.py
#
# Replaces the JWT_SIGNING_SECRET the inherited .env carried.
JWT_PRIVATE_KEY_PATH=secrets/jwt_ed25519_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_ed25519_public.pem
JWT_KEY_ID=graphrec-local-1
JWT_ISSUER=https://api.graphrec.example
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------- credentials
AUDIT_HASH_SECRET=replace-with-a-long-random-local-secret
API_KEY_HMAC_PEPPER=local-api-key-hmac-pepper-change-me
API_KEY_HASH_VERSION=1
MAX_ACTIVE_API_KEYS_PER_TENANT=25
MAX_API_KEY_NAME_LENGTH=100
MAX_API_KEY_SCOPES=12
MAX_API_KEY_ROTATION_REASON_LENGTH=500
MAX_API_KEY_GRACE_SECONDS=86400

# ---------------------------------------------------------------- request bounds
#
# Per-endpoint, not global — D7. The inherited single MAX_REQUEST_BODY_BYTES
# capped every request at 16 KB, which is roughly 37x too small for the
# 5,000-product synchronization the console offers.
MAX_REQUEST_BODY_BYTES=16384
MAX_BULK_BODY_BYTES=2097152
MAX_TENANT_NAME_LENGTH=200
MAX_PASSWORD_LENGTH=1024
MAX_IDEMPOTENCY_KEY_LENGTH=255
IDEMPOTENCY_KEY_TTL_SECONDS=86400
MIN_REASON_LENGTH=4

# ---------------------------------------------------------------- rate limits
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=60
API_KEY_RATE_LIMIT=10
API_KEY_RATE_WINDOW_SECONDS=60
USAGE_RATE_LIMIT=30
USAGE_RATE_WINDOW_SECONDS=60
SUBSCRIPTION_RATE_LIMIT=30
SUBSCRIPTION_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------- jobs
# PostgreSQL SELECT ... FOR UPDATE SKIP LOCKED over a jobs table — D2.
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- training
# TRAINING_COOLDOWN_SECONDS is provisional: it appears only on a stat card in
# the console prototype and nowhere in the SRS. Pending confirmation.
TRAINING_GLOBAL_CONCURRENCY=1
TRAINING_COOLDOWN_SECONDS=900
TRAINING_MIN_SEQUENCES=1000

# ---------------------------------------------------------------- ingestion
MAX_PRODUCTS_PER_SYNC=5000
MAX_EVENTS_PER_BATCH=5000
EVENT_FUTURE_WINDOW_HOURS=24
EVENT_PAST_WINDOW_DAYS=90
MAX_SUBMISSION_ERROR_SAMPLES=100

# ---------------------------------------------------------------- serving
RECOMMENDATION_MAX_TOP_N=100
RECOMMENDATION_MAX_RECENT_EVENTS=50
RECOMMENDATION_MAX_EXCLUSIONS=200
SESSION_TTL_SECONDS=1800

# compose | k3s — D3. Compose is the default; k3s is added for the XR-F-08
# scaling demonstration. Both report desired/ready replicas identically.
SERVING_DRIVER=compose

# inprocess | qdrant — D4. In-process exact top-K by default; the Qdrant adapter
# implements the SRS §6.3 collection contract when it must be demonstrated.
CANDIDATE_INDEX=inprocess

# ---------------------------------------------------------------- candidate index
QDRANT_URL=http://qdrant:6334
QDRANT_COLLECTION_PREFIX=graphrec
QDRANT_EMBEDDING_DIM=128
QDRANT_TOP_K=100

# ---------------------------------------------------------------- observability
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_URL=http://localhost:9090

# ---------------------------------------------------------------- email
#
# Invitations (/invite/accept) and account recovery (/recover) both need
# out-of-band token delivery. Leave SMTP_HOST unset to fall back to the admin
# CLI, which prints the token; the API logs a warning at startup when it does.
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@graphrec.example
SMTP_USE_TLS=true

# ---------------------------------------------------------------- demo bootstrap
DEMO_TENANT_NAME=GraphRec Local Demo
DEMO_REGISTRATION_EMAIL=owner-demo@example.org
DEMO_LOGIN_EMAIL=demo-admin@example.org
DEMO_LOGIN_PASSWORD=local-demo-password-change-me
