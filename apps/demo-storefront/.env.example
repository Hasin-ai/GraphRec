# GraphRec API the storefront server talks to (never exposed to the browser)
GRAPHREC_BASE_URL=http://localhost:8010
# Storefront key: catalog:read catalog:write events:read events:write recommendations:read
GRAPHREC_API_KEY=gr_live_replace_me
# Optional key with training/model scopes for scripts/seed.py (falls back to GRAPHREC_API_KEY)
GRAPHREC_SEED_API_KEY=

DEMO_PORT=5190
# Let scripts/seed.py disable tenant products that are not in the demo feed
DEMO_DISABLE_MISSING=false

# Only set these after scripts/verify_personalization.py has passed for that exact version
MODEL_PROOF_VERIFIED=false
MODEL_PROOF_VERSION_ID=
